                          "fetchXml": "<!--\nCreated from query:\n\nselect\nsystemuser.systemuserid,\nsystemuser.fullname,\nsystemuser.internalemailaddress,\nteam.teamid,\nteam.name\nfrom\nteam\ninner join teammembership teammembership1 ON team.teamid = teammembership1.teamid\ninner join teammembership teammembership2 ON teammembership1.teamid = teammembership2.teamid\ninner join systemuser ON teammembership2.systemuserid = systemuser.systemuserid\nwhere\nteam.isdefault = 0\nand team.teamtype = 0\nand teammembership1.systemuserid = '8124c8bd-a0c4-ee11-9079-6045bd536271'\nand systemuser.isdisabled = 0\n\n-->\n\n\n<fetch xmlns:generator='MarkMpn.SQL4CDS'>\n  <entity name='team'>\n    <attribute name='teamid' />\n    <attribute name='name' />\n    <link-entity name='teammembership' to='teamid' from='teamid' alias='teammembership' link-type='inner'>\n      <link-entity name='teammembership' to='teamid' from='teamid' alias='teammembership2' link-type='inner'>\n        <link-entity name='systemuser' to='systemuserid' from='systemuserid' alias='systemuser' link-type='inner'>\n          <attribute name='systemuserid' />\n          <attribute name='fullname' />\n          <attribute name='internalemailaddress' />\n          <filter>\n            <condition attribute='isdisabled' operator='eq' value='0' />\n          </filter>\n        </link-entity>\n      </link-entity>\n      <filter>\n        <condition attribute='systemuserid' operator='in'>\n          @{concat('<value>',replace(trim(triggerBody()?['text_1']),',','</value> <value>'),'</value>')}\n        </condition>\n      </filter>\n    </link-entity>\n    <filter>\n      <condition attribute='teamtype' operator='eq' value='0' />\n      <condition attribute='isdefault' operator='eq' value='0' />\n    </filter>\n  </entity>\n</fetch>"
